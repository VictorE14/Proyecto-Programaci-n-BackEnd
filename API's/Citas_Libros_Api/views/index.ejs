<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mi Biblioteca</title>
    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
    <h1>📚 Mi Biblioteca</h1>
    
    <div class="card">
        <% if (cover) { %>
            <img src="<%= cover %>" alt="Portada de <%= title %>">
        <% } else { %>
            <div class="no-cover">
                📖 Sin Portada
            </div>
        <% } %>
        
        <div class="info">
            <h2><%= title %></h2>
            <p><strong>✍️ Autor:</strong> <%= author %></p>
            <p><strong>📄 Páginas:</strong> <%= pages %></p>
        </div>
    </div>

    <a href="/" class="btn">🔄 Refrescar Libro</a>
</body>
</html>